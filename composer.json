{
    "name": "slimad/indexnow",
    "description": "Framework-agnostic IndexNow client and queue for submitting URL changes to participating search engines (Bing, Yandex, Seznam, Naver, Yep).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "indexnow",
        "seo",
        "bing",
        "yandex",
        "search-engine",
        "indexing"
    ],
    "authors": [
        {
            "name": "Maciej Kosiedowski"
        }
    ],
    "require": {
        "php": "^8.1",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.12",
        "phpstan/phpstan-strict-rules": "^1.6",
        "phpstan/phpstan-phpunit": "^1.4",
        "infection/infection": "^0.27 || ^0.29",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "SlimAD\\IndexNow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SlimAD\\IndexNow\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text --coverage-html=build/coverage",
        "phpstan": "phpstan analyse",
        "infection": "infection --threads=4 --min-msi=100 --min-covered-msi=100",
        "ci": [
            "@phpstan",
            "@test",
            "@infection"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
